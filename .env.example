# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Optional: restrict who can sign in. Without it, anyone who reaches your
# public URL can request a magic link and gets their own workspace. Comma
# separated, case insensitive.
# ALLOWED_EMAILS=you@example.com,teammate@example.com

# Optional: use your own SMTP server instead of Resend. When EMAIL_SERVER is
# set it takes over and RESEND_API_KEY is not needed. URL-encode special
# characters in user and password (@ becomes %40).
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional account-protection limits. All off when unset, which keeps the
# original behaviour: Meta's documented 750 private replies an hour and nothing
# else. Meta's cap is the refusal line, not a safe speed for an account that
# has never sent an automated DM, so a new account wants all of these.
# DM_RATE_LIMIT_PER_HOUR=60          # lower hourly ceiling; capped at Meta's 750
# DM_DAILY_LIMIT=50                  # flat daily cap, 0/unset = none
# DM_DAILY_LIMIT_RAMP=50,50,50,100,200  # per-day caps by account age; overrides the flat cap
# DM_MIN_SPACING_SECONDS=45          # minimum gap between two sends on one account
# DM_SPACING_JITTER_SECONDS=45       # random extra gap on top, so it is not a constant
# DM_ONE_PER_PERSON=true             # never DM the same person twice for one campaign
# DM_AUTOPAUSE_ON_RESTRICTION=true   # pause every campaign on the account if Instagram pushes back
# SAFETY_ALERT_EMAIL=you@example.com # where the autopause warning is sent (uses EMAIL_SERVER)
